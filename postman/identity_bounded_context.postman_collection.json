{
  "info": {
    "_postman_id": "9a42bbd5-d75c-49c6-9b20-0328a0ebc0df",
    "name": "Dorsales API - Identity Bounded Context",
    "description": "Postman collection for identity bounded context REST endpoints. Authentication is handled by the API bearer-token middleware; Cognito signup and login are external to these REST routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "11111111-1111-4111-8111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Returns the authenticated user's private profile. A valid bearer token is required; the identity middleware validates the token and resolves or provisions the local user."
          },
          "response": []
        },
        {
          "name": "Get My Profile - Missing Token (unauthorized error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Expects 401 Unauthorized because /api/v1/me requires an authenticated user."
          },
          "response": []
        },
        {
          "name": "Patch My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Runner\",\n  \"dni\": \"12345678Z\",\n  \"gender\": \"female\",\n  \"age\": 30,\n  \"phone_number\": \"+34600111222\",\n  \"whatsapp_number\": \"+34600111222\",\n  \"postal_code\": \"28001\",\n  \"address\": \"Street 1\",\n  \"estimated_time\": \"00:45:00\",\n  \"t_shirt_size\": \"M\",\n  \"club\": \"Club\",\n  \"federation_license\": \"FED123\",\n  \"medical_info\": \"None\",\n  \"emergency_contact\": \"+34600999888\",\n  \"additional_info\": \"Prefers email contact.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Partially updates the authenticated user's profile. Only fields present in the request body are updated. estimated_time must use HH:MM:SS format; age must be between 14 and 120."
          },
          "response": []
        },
        {
          "name": "Patch My Profile - Minimal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Updates a single profile field. Omitted fields are left unchanged."
          },
          "response": []
        },
        {
          "name": "Patch My Profile - Invalid Age (validation error)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 13\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Expects 422 Unprocessable Entity because age must be greater than or equal to 14."
          },
          "response": []
        },
        {
          "name": "Patch My Profile - Invalid Estimated Time (validation error)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estimated_time\": \"45:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Expects 422 Unprocessable Entity because estimated_time must match HH:MM:SS."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Public Profiles",
      "item": [
        {
          "name": "Get Public Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{user_id}}/public",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{user_id}}",
                "public"
              ]
            },
            "description": "Returns a user's public identity profile and marketplace reputation summary. This endpoint does not require authentication."
          },
          "response": []
        },
        {
          "name": "Get Public Profile - Unknown User (not found error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/00000000-0000-4000-8000-000000000000/public",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "00000000-0000-4000-8000-000000000000",
                "public"
              ]
            },
            "description": "Expects 404 Not Found when the requested user does not exist."
          },
          "response": []
        }
      ]
    }
  ]
}
